# ==============================================================================
# Sports Management System - Docker Compose Environment Variables (Template)
# Sao chep thanh file .env (duoc Git ignore) va cap nhat gia tri phu hop truoc khi chay:
#   Copy-Item .env.example .env
# ==============================================================================

# --- Bao mat JWT & CORS (Bat buoc JWT_SECRET >= 32 ky tu) ---
JWT_SECRET=replace-with-random-secret-key-at-least-32-characters-long
CORS_ALLOWED_ORIGINS=http://localhost:8080

# --- Che do tai khoan Demo (Mac dinh tat; chi bat =true khi kiem thu) ---
APP_DEMO_ENABLED=false
APP_DEMO_SEED_USERS=false

# --- PostgreSQL (Database-per-Service trong cung 1 container Postgres) ---
DB_USERNAME=sports
DB_PASSWORD=replace-with-local-postgres-password
POSTGRES_PORT=5432

# --- RabbitMQ Broker ---
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- Cong publish ra may chu (Co the doi khi trung cong tren may local) ---
REGISTRY_PORT=8761
GATEWAY_PORT=8080
AUTH_PORT=8083
TOURNAMENT_PORT=8081
TOURNAMENT_2_PORT=8091
MATCH_PORT=8082
NOTIFICATION_PORT=8084
TEAM_PORT=8085
ATHLETE_PORT=8086
RESULT_PORT=8087
RANKING_PORT=8088

# --- Tuy chon JVM trong container ---
JAVA_TOOL_OPTIONS=-Xms64m -Xmx224m -XX:MaxMetaspaceSize=128m -Duser.timezone=Asia/Ho_Chi_Minh

# --- Gioi han thoi gian cho loi goi giua cac service (mili giay) ---
SERVICES_CONNECT_TIMEOUT_MS=2000
SERVICES_READ_TIMEOUT_MS=10000

# --- Mat khau tai khoan DB rieng cua tung service (bo trong thi dung DB_PASSWORD) ---
AUTH_DB_PASSWORD=
TOURNAMENT_DB_PASSWORD=
TEAM_DB_PASSWORD=
ATHLETE_DB_PASSWORD=
MATCH_DB_PASSWORD=
RESULT_DB_PASSWORD=
RANKING_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=

# --- Giam sat (chi dung khi chay: docker compose --profile monitoring up -d) ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-grafana-admin-password
