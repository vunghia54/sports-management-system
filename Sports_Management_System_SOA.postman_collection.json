  "item": [
    {
      "name": "0. Service Registry - Eureka Server (Port 8761) [TH7]",
      "item": [
        {
          "name": "0.1 Kiểm tra danh sách Microservices đã đăng ký trên Eureka (JSON)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{registryUrl}}/eureka/apps",
              "host": ["{{registryUrl}}"],
              "path": ["eureka", "apps"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Eureka Server trả về HTTP 200', function () { pm.response.to.have.status(200); });",
                  "var res = pm.response.json();",
                  "pm.test('Có danh sách applications đăng ký', function () { pm.expect(res.applications).to.be.an('object'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Auth Service (Port 8083) [TH1 - TH7]",
      "item": [
        {
          "name": "1.1 Kiểm tra thông tin Service (/info - TH1)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{authUrl}}/api/v1/auth/info",
              "host": ["{{authUrl}}"],
              "path": ["api", "v1", "auth", "info"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code 200', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.2 Đăng ký tài khoản Lãnh đội (ROLE_TEAM_MANAGER - đăng ký công khai chỉ nhận VIEWER/TEAM_MANAGER)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"manager_postman\",\n  \"password\": \"password123\",\n  \"fullName\": \"Lãnh Đội CLB Postman\",\n  \"email\": \"manager_postman@sports.vn\",\n  \"role\": \"ROLE_TEAM_MANAGER\"\n}"
            },
            "url": {
              "raw": "{{authUrl}}/api/v1/auth/register",
              "host": ["{{authUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code 200/201 hoặc 400/409 (nếu đã tồn tại)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 400, 409]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.3 Đăng nhập Organizer & Tự động lưu JWT Token (TH6)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"organizer1\",\n  \"password\": \"organizer123\"\n}"
            },
            "url": {
              "raw": "{{authUrl}}/api/v1/auth/login",
              "host": ["{{authUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Đăng nhập thành công 200', function () { pm.response.to.have.status(200); });",
                  "var res = pm.response.json();",
                  "pm.test('Nhận được accessToken', function () { pm.expect(res.accessToken).to.be.a('string'); });",
                  "pm.collectionVariables.set('organizerToken', res.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.4 Xác thực Profile Người dùng (/me) với JWT (TH6)",
