									"});",
									"pm.test('Tồn tại thông báo type=MATCH_FINISHED có referenceId == testMatchId từ RabbitMQ', function () {",
									"    const resBody = pm.response.json();",
									"    const list = Array.isArray(resBody) ? resBody : (resBody.content || []);",
									"    const targetId = Number(pm.collectionVariables.get('testMatchId'));",
									"    const found = list.find((n) => n.type === 'MATCH_FINISHED' && Number(n.referenceId) === targetId);",
