		{
			"name": "1. [Auth] Đăng nhập Organizer, Team Manager, Referee",
			"item": [
				{
					"name": "1.1 Login Organizer (organizer1)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const tag = Date.now().toString().slice(-7);",
									"pm.collectionVariables.set('runTag', tag);",
									"const now = new Date();",
									"const pad = (n) => String(n).padStart(2, '0');",
									"const fmt = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;",
									"const fmtDt = (d) => `${fmt(d)}T${pad(d.getHours())}:${pad(d.getMinutes())}:00`;",
									"const addDays = (d, n) => new Date(d.getTime() + n * 86400000);",
									"const todayStr = fmt(now);",
									"pm.collectionVariables.set('regStart', fmt(addDays(now, -5)));",
									"pm.collectionVariables.set('pastStart', fmt(addDays(now, -3)));",
									"pm.collectionVariables.set('regEnd', todayStr);",
									"pm.collectionVariables.set('tourStart', todayStr);",
									"pm.collectionVariables.set('tourEnd', fmt(addDays(now, 20)));",
									"pm.collectionVariables.set('pastMatchTime', fmtDt(new Date(now.getTime() - 24 * 3600000)));",
									"pm.sendRequest(pm.collectionVariables.replaceIn('{{matchUrl}}/api/v1/matches'), function (err, res) {",
									"    if (err || !res) return;",
									"    try {",
									"        const body = res.json();",
									"        const list = Array.isArray(body) ? body : (body.content || []);",
									"        const toMs = (v) => Array.isArray(v) ? new Date(v[0], v[1]-1, v[2], v[3]||0, v[4]||0).getTime() : new Date(v).getTime();",
									"        const busyTimes = list.filter((m) => m.matchTime && (!m.refereeUsername || m.refereeUsername === 'referee1')).map((m) => toMs(m.matchTime));",
									"        for (let minsAgo = 60; minsAgo <= 68 * 60; minsAgo += 30) {",
									"            const cand = new Date(now.getTime() - minsAgo * 60000);",
									"            cand.setSeconds(0, 0);",
									"            const candMs = cand.getTime();",
									"            if (busyTimes.every((b) => Math.abs(candMs - b) >= 2.5 * 3600 * 1000)) {",
									"                pm.collectionVariables.set('pastMatchTime', fmtDt(cand));",
									"                return;",
									"            }",
									"        }",
									"    } catch (_) {}",
									"});",
									"pm.collectionVariables.set('dob', fmt(addDays(now, -21 * 365)));",
									"pm.collectionVariables.set('cccd1', '0796' + tag + '1');",
									"pm.collectionVariables.set('cccd2', '0796' + tag + '2');"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Login organizer1 200 OK', function () { pm.response.to.have.status(200); });",
									"pm.collectionVariables.set('orgToken', pm.response.json().accessToken);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"username\": \"organizer1\",\n  \"password\": \"organizer123\"\n}" },
						"url": { "raw": "{{authUrl}}/api/v1/auth/login", "host": ["{{authUrl}}"], "path": ["api", "v1", "auth", "login"] }
					}
				},
