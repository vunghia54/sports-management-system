	"item": [
		{
			"name": "1. TC01 - Kiểm tra Service Registry (Eureka Server :8761)",
			"item": [
				{
					"name": "TC01.1 - Xem danh sách tất cả Microservices đã đăng ký trên Eureka",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
									"const apps = pm.response.json().applications.application;",
									"const appNames = apps.map(a => a.name);",
									"pm.test('All required microservices are registered in Eureka', function () {",
									"    pm.expect(appNames).to.include('API-GATEWAY');",
									"    pm.expect(appNames).to.include('AUTH-SERVICE');",
									"    pm.expect(appNames).to.include('TOURNAMENT-SERVICE');",
									"    pm.expect(appNames).to.include('MATCH-SERVICE');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": { "raw": "{{eurekaUrl}}/eureka/apps", "host": ["{{eurekaUrl}}"], "path": ["eureka", "apps"] }
					}
				},
				{
					"name": "TC01.2 - Kiểm tra các instance của TOURNAMENT-SERVICE trên Eureka",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
									"const app = pm.response.json().application;",
									"const instances = Array.isArray(app.instance) ? app.instance : [app.instance];",
									"pm.test('TOURNAMENT-SERVICE has at least 2 UP instances', function () {",
									"    pm.expect(instances.length).to.be.at.least(2);",
									"    instances.forEach(inst => pm.expect(inst.status).to.eql('UP'));",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": { "raw": "{{eurekaUrl}}/eureka/apps/TOURNAMENT-SERVICE", "host": ["{{eurekaUrl}}"], "path": ["eureka", "apps", "TOURNAMENT-SERVICE"] }
					}
				}
			]
		},
