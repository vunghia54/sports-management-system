		{
			"name": "3. Luồng nghiệp vụ Tạo Lịch Thi Đấu qua Service Discovery (Match -> Tournament)",
			"item": [
				{
					"name": "3.1 - Đăng nhập lấy JWT Token (organizer1 / organizer123)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const tag = Date.now().toString().slice(-7);",
									"pm.collectionVariables.set('runTag', tag);",
									"const now = new Date();",
									"const pad = (n) => String(n).padStart(2, '0');",
									"const fmt = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;",
									"const addDays = (d, n) => new Date(d.getTime() + n * 86400000);",
									"pm.collectionVariables.set('regStart', fmt(addDays(now, -3)));",
									"pm.collectionVariables.set('regEnd', fmt(now));",
									"pm.collectionVariables.set('tourStart', fmt(now));",
									"pm.collectionVariables.set('tourEnd', fmt(addDays(now, 90)));",
									"pm.collectionVariables.set('matchTimeDynamic', fmt(addDays(now, 3 + (Number(tag) % 75))) + 'T19:00:00');",
									"pm.sendRequest(pm.collectionVariables.replaceIn('{{matchServiceUrl}}/api/v1/matches'), function (err, res) {",
									"    if (err || !res) return;",
									"    try {",
									"        const body = res.json();",
									"        const list = Array.isArray(body) ? body : (body.content || []);",
									"        const toMs = (v) => Array.isArray(v) ? new Date(v[0], v[1]-1, v[2], v[3]||0, v[4]||0).getTime() : new Date(v).getTime();",
									"        const busyTimes = list.filter((m) => m.matchTime && (!m.refereeUsername || m.refereeUsername === 'referee1')).map((m) => toMs(m.matchTime));",
									"        for (let d = 3; d <= 85; d++) {",
									"            for (const hh of ['09', '14', '19']) {",
									"                const candStr = `${fmt(addDays(now, d))}T${hh}:00:00`;",
									"                const candMs = new Date(candStr).getTime();",
									"                if (busyTimes.every((b) => Math.abs(candMs - b) >= 3 * 3600 * 1000)) {",
									"                    pm.collectionVariables.set('matchTimeDynamic', candStr);",
									"                    return;",
									"                }",
									"            }",
									"        }",
									"    } catch (_) {}",
									"});",
									"pm.collectionVariables.set('dobDynamic', fmt(addDays(now, -21 * 365)));",
									"pm.collectionVariables.set('cccd1', '0797' + tag + '1');",
									"pm.collectionVariables.set('cccd2', '0797' + tag + '2');"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Login organizer1 200 OK', function () { pm.response.to.have.status(200); });",
									"pm.collectionVariables.set('jwtToken', pm.response.json().accessToken);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"username\": \"organizer1\",\n  \"password\": \"organizer123\"\n}" },
						"url": { "raw": "{{authServiceUrl}}/api/v1/auth/login", "host": ["{{authServiceUrl}}"], "path": ["api", "v1", "auth", "login"] }
					}
				},
				{
					"name": "3.1b - Đăng nhập manager1 cho bước đăng ký đội",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Login manager1 200 OK', function () { pm.response.to.have.status(200); });",
									"pm.collectionVariables.set('mgrToken', pm.response.json().accessToken);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"username\": \"manager1\",\n  \"password\": \"manager123\"\n}" },
						"url": { "raw": "{{authServiceUrl}}/api/v1/auth/login", "host": ["{{authServiceUrl}}"], "path": ["api", "v1", "auth", "login"] }
					}
				},
				{
