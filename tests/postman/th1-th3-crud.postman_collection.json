    {
      "name": "13. [TH3] Sort - sortBy=fullName&direction=desc -> 200 OK",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Sort by fullName desc returns CCC before BBB before AAA', function () {",
              "    pm.response.to.have.status(200);",
              "    const list = pm.response.json();",
              "    pm.expect(list).to.be.an('array').with.length.at.least(3);",
