      "name": "11. [TH3] Pagination - /paged?page=0&size=2 -> 200 OK",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Paged query returns 2 items on page 0 with metadata', function () {",
