    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "managerToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "runTag", "value": "" },
    { "key": "athleteId", "value": "" },
    { "key": "athleteBId", "value": "" },
    { "key": "athleteCId", "value": "" },
    { "key": "athleteCccdA", "value": "" },
    { "key": "athleteCccdB", "value": "" },
    { "key": "athleteCccdC", "value": "" },
    { "key": "dobDynamic", "value": "" }
