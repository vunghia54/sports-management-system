  "item": [
    {
      "name": "0. Auth - Login Team Manager (manager1)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now().toString().slice(-8);",
              "pm.collectionVariables.set('runTag', 'TH13_' + suffix);",
              "pm.collectionVariables.set('athleteCccdA', '079' + suffix + '1');",
              "pm.collectionVariables.set('athleteCccdB', '079' + suffix + '2');",
              "pm.collectionVariables.set('athleteCccdC', '079' + suffix + '3');",
              "const dob = new Date(Date.now() - 22 * 365 * 24 * 60 * 60 * 1000).toISOString().slice(0, 10);",
              "pm.collectionVariables.set('dobDynamic', dob);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login manager1 returns 200 OK with JWT', function () {",
              "    pm.response.to.have.status(200);",
              "    const json = pm.response.json();",
              "    pm.expect(json.accessToken).to.be.a('string').and.not.empty;",
              "    pm.collectionVariables.set('managerToken', json.accessToken);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"manager1\",\n  \"password\": \"manager123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "login"]
        }
      }
    },
    {
      "name": "0b. Auth - Login Admin (admin for DELETE)",
      "event": [
